dist_e <- "norm"
dist_c <- "norm"
type <- "MAR"
prob = c(0.025, 0.975)
n.chains = 2
n.iter = 2000
n.burnin = floor(n.iter / 2)
inits = NULL
n.thin = 1
save_model = FALSE
prior = "default"
center = FALSE
data.adj <- data
data.adj$c <- data$c + 0.01
data.adj$e <- data$e - 0.01
mod1 <- selection(data = data.adj, model.eff = model.eff, model.cost = model.cost,
model.me = model.me, model.mc = model.mc,
dist_e = dist_e, dist_c = dist_c, type = type,
n.iter = n.iter, n.mci = 1000)
