MIboot_mu_int_adjTC_y1
mod_est_imp_boot[3,,]
MIboot_mu_int_adjTC_y1
MIboot_mu_ctr_adjTC_y1_low <- MIboot_mu_int_adjTC_y1 + 0.05*MIboot_mu_int_adjTC_y1
MIboot_delta_adjTC_y1_low <- MIboot_mu_int_adjTC_y1 - MIboot_mu_ctr_adjTC_y1_low
# mean adj TCs (over year 1 - ctr) = # mean adj TCs (over year 1 - int) + 0.1*mean adj TCs (over year 1 - int)
MIboot_mu_ctr_adjTC_y1_high <- MIboot_mu_int_adjTC_y1 + 0.1*MIboot_mu_int_adjTC_y1
MIboot_delta_adjTC_y1_high <- MIboot_mu_int_adjTC_y1 - MIboot_mu_ctr_adjTC_y1_high
fit_tc_y1_gamma_imp_low <- fit_tc_y1_gamma_imp_high <- list()
MIboot_mu_ctr_tc_y1_v2_low <- MIboot_mu_ctr_tc_y1_v2_high <- matrix(NA, nrow = m, ncol = B)
mu_int_tc_y1_imp_low <- sd_int_tc_y1_imp_low <- mu_ctr_tc_y1_imp_low <- c()
mu_int_tc_y1_imp_high <- sd_int_tc_y1_imp_high <- mu_ctr_tc_y1_imp_high <- c()
k<-1
mod_est_imp_boot[3,k,]
mod_est_imp_boot
dim(mod_est_imp_boot)
mu_int_tc_y1_imp
MIboot_mu_ctr_tc_y1_v2_low <- MIboot_mu_ctr_tc_y1_v2_high <- matrix(NA, nrow = m, ncol = B)
mu_ctr_tc_y1_imp_low <- mu_ctr_tc_y1_imp_high <- c()
for(k in 1:m){
mu_ctr_tc_y1_imp_low[k] <- mu_int_tc_y1_imp[k] + 0.05*mu_int_tc_y1_imp[k]
MIboot_mu_ctr_tc_y1_v2_low[k,] <- rgamma(dim(mod_est_imp_boot)[3], shape = mu_ctr_tc_y1_imp_low[k]^2/sd_int_tc_y1_imp[k]^2, rate = mu_ctr_tc_y1_imp_low[k]/sd_int_tc_y1_imp[k]^2)
mu_ctr_tc_y1_imp_high[k] <- mu_int_tc_y1_imp[k] + 0.1*mu_int_tc_y1_imp[k]
MIboot_mu_ctr_tc_y1_v2_high[k,] <- rgamma(dim(mod_est_imp_boot)[3], shape = mu_ctr_tc_y1_imp_high[k]^2/sd_int_tc_y1_imp[k]^2, rate = mu_ctr_tc_y1_imp_high[k]/sd_int_tc_y1_imp[k]^2)
}
MIboot_delta_tc_y1_v2_low <- MIboot_mu_int_adjTC_y1 - MIboot_mu_ctr_tc_y1_v2_low
MIboot_delta_tc_y1_v2_high <- MIboot_mu_int_adjTC_y1 - MIboot_mu_ctr_tc_y1_v2_high
mod_ctr_tc_y1_boot_pooledMB_low <- c(mean(MIboot_mu_ctr_adjTC_y1_low),apply(apply(MIboot_mu_ctr_adjTC_y1, 1, quantile, probs=c(0.025,0.975)),1,mean))
mod_delta_tc_y1_boot_pooledMB_low <- c(mean(MIboot_delta_adjTC_y1_low),apply(apply(MIboot_delta_adjTC_y1, 1, quantile, probs=c(0.025,0.975)),1,mean))
mod_ctr_tc_y1_boot_pooledMB_high <- c(mean(MIboot_mu_ctr_adjTC_y1_high),apply(apply(MIboot_mu_ctr_adjTC_y1, 1, quantile, probs=c(0.025,0.975)),1,mean))
mod_delta_tc_y1_boot_pooledMB_high <- c(mean(MIboot_delta_adjTC_y1_high),apply(apply(MIboot_delta_adjTC_y1, 1, quantile, probs=c(0.025,0.975)),1,mean))
