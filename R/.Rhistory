library(bookdown)
library(ggplot2)
options(width = 300)
set.seed(1234)
debug(selection)
selection(data = MenSS, model.eff = e ~ trt + u.0,
model.cost = c ~ trt, model.me = me ~ e,
model.mc = mc ~ 1, type = "MNAR",
n.iter = 1000, ref = 2,
dist_e = "norm", dist_c = "norm")
fixed_e
any(grepl("0", format(fixed_e)))
format(fixed_e)
attr(terms(fixed_e), "intercept") == 0
attr(terms(e ~ trt + u.0), "intercept") == 0
attr(terms(e ~ trt + 0), "intercept") == 0
attr(terms(form), "intercept") == 0
attr(terms(fixed_e), "intercept") == 0
if(attr(terms(e~0+trt), "intercept") == 0 | attr(terms(e~0+trt), "intercept") == 0) {
stop("No-intercept models are not allowed. Please remove `0` from `model.eff` and/or `model.cost`")}
